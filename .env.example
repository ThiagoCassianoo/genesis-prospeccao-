# Copie pra .env (gitignored) e preencha o que for usar.

# Descoberta de empresa local (coleta/src/maps.js) — nenhuma é
# obrigatória: sem nenhuma chave, o sistema usa OpenStreetMap (grátis,
# sem cadastro, sem telefone). Prioridade: Apify > TomTom > Google > OSM.
# ATENÇÃO: OSM sozinho não serve pra campanha de WhatsApp — não retorna
# telefone. Use TomTom (grátis) ou Apify (pago) se o objetivo é contato.
APIFY_API_TOKEN=
TOMTOM_API_KEY=
GOOGLE_MAPS_API_KEY=
